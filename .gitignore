# SiMoSoBa Gitignore - PHP/Vercel Optimized

# Dependencies
/vendor/
node_modules/

# Environment / Secret Files
.env
.env.local
.env.*.local
config/secrets.php

# Vercel
.vercel
/out/

# Logs and databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS Files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Temporary files
/tmp/
/scratch/
api/server/database.sql
