# ==============================================================
# ANTIGRAVITY — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ==============================================================

# --- TiDB Cloud / MySQL Connection ---
# Get these from your TiDB Cloud cluster's "Connect" panel
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=antigravity

# --- JWT Auth Secret (generate with: openssl rand -base64 32) ---
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_32_chars

# --- App Base URL (used for WhatsApp share links, etc.) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
