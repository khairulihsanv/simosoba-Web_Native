{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.5"
    }
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1",
      "headers": { "cache-control": "s-maxage=31536000, immutable", "Content-Type": "text/css" }
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1",
      "headers": { "cache-control": "s-maxage=31536000, immutable", "Content-Type": "application/javascript" }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}